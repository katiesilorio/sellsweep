# Sellsweep credentials — copy to .env and fill in.
# .env is git-ignored. Never commit real values. No passwords belong in this file.

# ---------- Square ----------
# Developer Console -> Credentials. Sandbox first, production after the auto-publish test.
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

SQUARE_PROD_ACCESS_TOKEN=
SQUARE_PROD_LOCATION_ID=

# ---------- eBay ----------
# developer.ebay.com -> your application. Production keyset must be enabled
# (subscribe to or opt out of marketplace account-deletion notifications first).
EBAY_ENV=production
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_RUNAME=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US
# Set after the Step 0 check: true or false
EBAY_BUSINESS_POLICIES_OPTED_IN=
# Only needed if opted in:
EBAY_SHIPPING_PROFILE_ID=
EBAY_RETURN_PROFILE_ID=
EBAY_PAYMENT_PROFILE_ID=

# ---------- Etsy ----------
# developers.etsy.com -> Seller App. PKCE flow; refresh token expires ~90 days.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
ETSY_SHIPPING_PROFILE_ID=

# ---------- Facebook Marketplace ----------
# No credentials. Katie logs into his Facebook in Chrome herself;
# the skill drives the already-authenticated session and stops before submit.
